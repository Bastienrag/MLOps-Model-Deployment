{
 "uid": "imu-api",
 "title": "API IMU : 4 couches de monitoring",
 "tags": [
  "imu"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "1. Infrastructure : le service est-il up et rapide ?",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "API joignable",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up{job=\"imu-api\"}",
     "legendFormat": "__auto",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red"
        },
        "1": {
         "text": "UP",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Débit par route (req/s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (route)(rate(imu_http_requests_total[1m]))",
     "legendFormat": "{{route}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Latence de /v1/predict : P50 et P95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le)(rate(imu_http_request_duration_seconds_bucket{route=\"/v1/predict\"}[1m])))",
     "legendFormat": "P50",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le)(rate(imu_http_request_duration_seconds_bucket{route=\"/v1/predict\"}[1m])))",
     "legendFormat": "P95",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {},
   "description": "Cible : P95 sous 100 ms (voir « Test de charge » du README)."
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Erreurs : part de réponses 5xx et 4xx",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(sum(rate(imu_http_requests_total{status=~\"5..\"}[1m])) or vector(0)) / sum(rate(imu_http_requests_total[1m]))",
     "legendFormat": "5xx",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "(sum(rate(imu_http_requests_total{status=~\"4..\"}[1m])) or vector(0)) / sum(rate(imu_http_requests_total[1m]))",
     "legendFormat": "4xx",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "type": "row",
   "title": "2. Distribution des entrées : les trajets reçus ressemblent-ils à ceux d'entraînement ?",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Agitation (écart-type de |a|, m/s²) : médiane et P95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 6,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le)(rate(imu_input_accel_std_bucket[5m])))",
     "legendFormat": "médiane",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le)(rate(imu_input_accel_std_bucket[5m])))",
     "legendFormat": "P95",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Rotation (valeur efficace, °/s) : médiane et P95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 9,
    "w": 6,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le)(rate(imu_input_gyro_rms_bucket[5m])))",
     "legendFormat": "médiane",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le)(rate(imu_input_gyro_rms_bucket[5m])))",
     "legendFormat": "P95",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Longueur des trajets (mesures) : médiane et P95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 9,
    "w": 6,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le)(rate(imu_input_samples_bucket[5m])))",
     "legendFormat": "médiane",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le)(rate(imu_input_samples_bucket[5m])))",
     "legendFormat": "P95",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Part moyenne de lignes manquantes",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 9,
    "w": 6,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(imu_input_missing_fraction_sum[5m]) / rate(imu_input_missing_fraction_count[5m])",
     "legendFormat": "manquantes",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 11,
   "type": "row",
   "title": "3. Distribution des prédictions : le modèle répond-il de façon plausible ?",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Part de chaque classe prédite (5 min)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 10,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (predicted_class)(increase(imu_predictions_total[5m])) / scalar(sum(increase(imu_predictions_total[5m])))",
     "legendFormat": "{{predicted_class}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "stacking": {
       "mode": "normal"
      },
      "fillOpacity": 40
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 13,
   "type": "piechart",
   "title": "Classes prédites depuis le début",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 10,
    "y": 17,
    "w": 6,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (predicted_class)(imu_predictions_total)",
     "legendFormat": "{{predicted_class}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Confiance moyenne (probabilité de la classe prédite)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 17,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(imu_prediction_confidence_sum[5m]) / rate(imu_prediction_confidence_count[5m])",
     "legendFormat": "confiance moyenne",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {},
   "description": "Le hasard sur 5 classes donne 20 % ; une confiance qui s'effondre signale des entrées inhabituelles."
  },
  {
   "id": 15,
   "type": "row",
   "title": "4. Résultat métier : le modèle a-t-il raison ? (vérités terrain reçues par /v1/feedback)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 16,
   "type": "stat",
   "title": "Exactitude sur les retours reçus",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 25,
    "w": 5,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(imu_feedback_correct_total) / sum(imu_feedback_total)",
     "legendFormat": "__auto",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {},
   "description": "Attention : dominée par la classe Safe. Lire aussi la balanced accuracy."
  },
  {
   "id": 17,
   "type": "stat",
   "title": "Balanced accuracy (moyenne des rappels)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 5,
    "y": 25,
    "w": 5,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "avg(sum by (true_class)(imu_feedback_correct_total) / sum by (true_class)(imu_feedback_total))",
     "legendFormat": "__auto",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {},
   "description": "Référence : hasard 0,20 ; CNN en validation croisée 0,43."
  },
  {
   "id": 18,
   "type": "bargauge",
   "title": "Rappel par classe réelle",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 10,
    "y": 25,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (true_class)(imu_feedback_correct_total) / sum by (true_class)(imu_feedback_total)",
     "legendFormat": "{{true_class}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient"
   }
  },
  {
   "id": 19,
   "type": "stat",
   "title": "Retours reçus",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 25,
    "w": 6,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(imu_feedback_total)",
     "legendFormat": "__auto",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
